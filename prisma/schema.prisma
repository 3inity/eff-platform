generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  MATCH_ADMIN
  BET_ADMIN
  PLAYER_ADMIN
}

enum CompetitionType {
  LEAGUE
  CUP
  CUSTOM
}

enum CompetitionFormat {
  ROUND_ROBIN
  KNOCKOUT
  GROUP_STAGE
}

enum CompetitionStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
}

enum ParticipantStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum BetStatus {
  PENDING
  WON
  LOST
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Player {
  id                      String                   @id @default(cuid())
  username                String                   @unique
  xHandle                 String
  teamName                String
  nationality             String?
  avatarUrl               String?
  wins                    Int                      @default(0)
  draws                   Int                      @default(0)
  losses                  Int                      @default(0)
  goalsFor                Int                      @default(0)
  goalsAgainst            Int                      @default(0)
  coins                   Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  admins                  Admin[]
  credential              PlayerCredential?
  competitionParticipants CompetitionParticipant[]
  homeMatches             Match[]                  @relation("HomeMatches")
  awayMatches             Match[]                  @relation("AwayMatches")
  bets                    Bet[]
  withdrawals             Withdrawal[]
}

model PlayerCredential {
  id                 String    @id @default(cuid())
  playerId           String    @unique
  player             Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Admin {
  id             String      @id @default(cuid())
  playerId       String
  player         Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  role           AdminRole
  createdAt      DateTime    @default(now())
  auditLogs      AuditLog[]
  matchesEntered Match[]
}

model AuditLog {
  id          String    @id @default(cuid())
  adminId     String?
  admin       Admin?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  actionType  String
  targetTable String
  targetId    String
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime  @default(now())
  isReverted  Boolean   @default(false)
  revertedBy  String?
  revertedAt  DateTime?
}

model Competition {
  id                     String                   @id @default(cuid())
  name                   String
  description            String?
  additionalInfo         Json?
  matchdayDurationHours  Int                      @default(24)
  matchdayEndsAt         DateTime?
  type                   CompetitionType
  format                 CompetitionFormat
  status                 CompetitionStatus        @default(DRAFT)
  season                 String
  badgeKey               String?
  isActive               Boolean                  @default(true)
  registrationOpenAt     DateTime?
  registrationCloseAt    DateTime?
  maxParticipants        Int?
  requiresApproval       Boolean                  @default(false)
  createdAt              DateTime                 @default(now())
  teams                  Team[]
  participants           CompetitionParticipant[]
  matches                Match[]
}

model Team {
  id            String                   @id @default(cuid())
  competitionId String
  competition   Competition              @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name          String
  logoUrl       String?
  createdAt     DateTime                 @default(now())
  participants  CompetitionParticipant[]

  @@unique([competitionId, name])
}

model CompetitionParticipant {
  id            String            @id @default(cuid())
  competitionId String
  competition   Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId        String?
  team          Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamName      String?
  teamLogoUrl   String?
  status        ParticipantStatus @default(APPROVED)
  groupName     String?
  seed          Int?

  @@unique([competitionId, playerId])
}

model Match {
  id              String      @id @default(cuid())
  competitionId   String
  competition     Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  homePlayerId    String
  homePlayer      Player      @relation("HomeMatches", fields: [homePlayerId], references: [id], onDelete: Cascade)
  awayPlayerId    String
  awayPlayer      Player      @relation("AwayMatches", fields: [awayPlayerId], references: [id], onDelete: Cascade)
  homeScore       Int
  awayScore       Int
  playedAt        DateTime
  resultEnteredBy String
  admin           Admin       @relation(fields: [resultEnteredBy], references: [id], onDelete: Cascade)
}

model Bet {
  id         String    @id @default(cuid())
  playerId   String
  player     Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  stake      Int
  odds       Float
  selections Json
  status     BetStatus
  payout     Int?
  createdAt  DateTime  @default(now())
}

model Withdrawal {
  id        String           @id @default(cuid())
  playerId  String
  player    Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  amount    Int
  status    WithdrawalStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}
